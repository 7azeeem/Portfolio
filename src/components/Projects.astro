    class: "bg-[#FF9900] text-black",
  },
  S3: {
    name: "S3",
    class: "bg-[#527FFF] text-white",
  },
  CLOUDWATCH: {
    name: "CloudWatch",
    class: "bg-[#FF4F8B] text-white",
  },
  MYSQL: {
    name: "MySQL",
    class: "bg-[#00758F] text-white",
  },
  RABBITMQ: {
    name: "RabbitMQ",
    class: "bg-[#FF6600] text-white",
  },
  MEMCACHED: {
    name: "Memcached",
    class: "bg-[#4B8BBE] text-white",
  },
  TOMCAT: {
    name: "Tomcat",
    class: "bg-[#F8BC45] text-black",
  },
  NGINX: {
    name: "NGINX",
    class: "bg-[#009639] text-white",
  },
  TERRAFORM: {
    name: "Terraform",
    class: "bg-[#844FBA] text-white",
  },
  JENKINS: {
    name: "Jenkins",
    class: "bg-[#D33833] text-white",
  },
  SONARQUBE: {
    name: "SonarQube",
    class: "bg-[#4E9BCD] text-white",
  },
  DOCKER: {
    name: "Docker",
    class: "bg-[#2496ED] text-white",
  },
  AMAZON_ECR: {
    name: "Amazon ECR",
    class: "bg-[#FF9900] text-black",
  },
  AMAZON_ECS: {
    name: "Amazon ECS",
    class: "bg-[#FF9900] text-black",
  },
  AWS_IAM: {
    name: "AWS IAM",
    class: "bg-[#DD344C] text-white",
