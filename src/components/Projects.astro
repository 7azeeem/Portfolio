  },
  MAVEN: {
    name: "Maven",
    class: "bg-[#C71A22] text-white",
  },
  JAVA: {
    name: "Java",
    class: "bg-[#E76F00] text-white",
  },
  CICD: {
    name: "CI/CD",
    class: "bg-[#0052CC] text-white",
  },
  IAC: {
    name: "Infrastructure as Code",
    class: "bg-[#00A98F] text-white",
  },
  KUBERNETES: {
    name: "Kubernetes",
    class: "bg-[#326CE5] text-white",
  },
  AMAZON_EKS: {
    name: "Amazon EKS",
    class: "bg-[#FF9900] text-black",
  },
  GITHUB_ACTIONS: {
    name: "GitHub Actions",
    class: "bg-[#2088FF] text-white",
  },
