---
import GitHub from "./icons/GitHub.astro"
import LinkedIn from "./icons/LinkedIn.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import LinkButton from "./LinkButton.astro"
import SocialPill from "./SocialPill.astro"
import projectsData from "@/data/projects.json"

type Project = {
  title: string
  description: string
  image: string
  imageAlt?: string
  link?: string | null
  github?: string | null
  linkedin?: string | null
  tags: string[]
  gallery?: Array<{ src: string; alt: string }>
  repositories?: Array<{ label: string; url: string }>
}

const TAGS: Record<string, { name: string; class: string; icon?: any }> = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  AWS: {
    name: "AWS",
    class: "bg-[#232F3E] text-white",
  },
  ELASTIC_BEANSTALK: {
    name: "Elastic Beanstalk",
    class: "bg-[#86C232] text-black",
  },
  AMAZON_RDS: {
    name: "Amazon RDS",
    class: "bg-[#527FFF] text-white",
  },
  AMAZON_MQ: {
    name: "Amazon MQ",
    class: "bg-[#FF4F8B] text-white",
  },
  ELASTICACHE: {
    name: "ElastiCache",
    class: "bg-[#1F8ACB] text-white",
  },
  CLOUDFRONT: {
    name: "CloudFront",
    class: "bg-[#8C4FFF] text-white",
  },
  VPC: {
    name: "VPC",
    class: "bg-[#8C4FFF] text-white",
  },
  EC2: {
    name: "EC2",
    class: "bg-[#FF9900] text-black",
  },
  ROUTE53: {
    name: "Route 53",
    class: "bg-[#D05A3F] text-white",
  },
  ALB: {
    name: "Application Load Balancer",
    class: "bg-[#8C4FFF] text-white",
  },
  AUTOSCALING: {
