---
import GitHub from "./icons/GitHub.astro"
import LinkedIn from "./icons/LinkedIn.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import LinkButton from "./LinkButton.astro"
import SocialPill from "./SocialPill.astro"
import projectsData from "@/data/projects.json"

type Project = {
  title: string
  description: string
  image: string
  imageAlt?: string
  link?: string | null
  github?: string | null
  linkedin?: string | null
  tags: string[]
  gallery?: Array<{ src: string; alt: string }>
  repositories?: Array<{ label: string; url: string }>
}

const TAGS: Record<string, { name: string; class: string; icon?: any }> = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  AWS: {
    name: "AWS",
    class: "bg-[#232F3E] text-white",
  },
  ELASTIC_BEANSTALK: {
    name: "Elastic Beanstalk",
    class: "bg-[#86C232] text-black",
  },
  AMAZON_RDS: {
    name: "Amazon RDS",
    class: "bg-[#527FFF] text-white",
  },
  AMAZON_MQ: {
    name: "Amazon MQ",
    class: "bg-[#FF4F8B] text-white",
  },
  ELASTICACHE: {
    name: "ElastiCache",
    class: "bg-[#1F8ACB] text-white",
  },
  CLOUDFRONT: {
    name: "CloudFront",
    class: "bg-[#8C4FFF] text-white",
  },
  VPC: {
    name: "VPC",
    class: "bg-[#8C4FFF] text-white",
  },
  EC2: {
    name: "EC2",
    class: "bg-[#FF9900] text-black",
  },
  ROUTE53: {
    name: "Route 53",
    class: "bg-[#D05A3F] text-white",
  },
  ALB: {
    name: "Application Load Balancer",
    class: "bg-[#8C4FFF] text-white",
  },
  AUTOSCALING: {
    name: "Auto Scaling",
    class: "bg-[#FF9900] text-black",
  },
  S3: {
    name: "S3",
    class: "bg-[#527FFF] text-white",
  },
  CLOUDWATCH: {
    name: "CloudWatch",
    class: "bg-[#FF4F8B] text-white",
  },
  MYSQL: {
    name: "MySQL",
    class: "bg-[#00758F] text-white",
  },
  RABBITMQ: {
    name: "RabbitMQ",
    class: "bg-[#FF6600] text-white",
  },
  MEMCACHED: {
    name: "Memcached",
    class: "bg-[#4B8BBE] text-white",
  },
  TOMCAT: {
    name: "Tomcat",
    class: "bg-[#F8BC45] text-black",
  },
  NGINX: {
    name: "NGINX",
    class: "bg-[#009639] text-white",
  },
  TERRAFORM: {
    name: "Terraform",
    class: "bg-[#844FBA] text-white",
  },
  JENKINS: {
    name: "Jenkins",
    class: "bg-[#D33833] text-white",
  },
  SONARQUBE: {
    name: "SonarQube",
    class: "bg-[#4E9BCD] text-white",
  },
  DOCKER: {
    name: "Docker",
    class: "bg-[#2496ED] text-white",
  },
  AMAZON_ECR: {
    name: "Amazon ECR",
    class: "bg-[#FF9900] text-black",
  },
  AMAZON_ECS: {
    name: "Amazon ECS",
    class: "bg-[#FF9900] text-black",
  },
  AWS_IAM: {
    name: "AWS IAM",
    class: "bg-[#DD344C] text-white",
  },
  GITHUB: {
    name: "GitHub",
    class: "bg-[#181717] text-white",
  },
  SLACK: {
    name: "Slack",
    class: "bg-[#4A154B] text-white",
  },
  MAVEN: {
    name: "Maven",
    class: "bg-[#C71A22] text-white",
  },
  JAVA: {
    name: "Java",
    class: "bg-[#E76F00] text-white",
  },
  CICD: {
    name: "CI/CD",
    class: "bg-[#0052CC] text-white",
  },
  IAC: {
    name: "Infrastructure as Code",
    class: "bg-[#00A98F] text-white",
  },
  KUBERNETES: {
    name: "Kubernetes",
    class: "bg-[#326CE5] text-white",
  },
  AMAZON_EKS: {
    name: "Amazon EKS",
    class: "bg-[#FF9900] text-black",
  },
  GITHUB_ACTIONS: {
    name: "GitHub Actions",
    class: "bg-[#2088FF] text-white",
  },
  HELM: {
    name: "Helm",
    class: "bg-[#0F1689] text-white",
  },
  ARGO_CD: {
    name: "Argo CD",
    class: "bg-[#EF7B4D] text-black",
  },
  TRIVY: {
    name: "Trivy",
    class: "bg-[#1904DA] text-white",
  },
  CHECKSTYLE: {
    name: "Checkstyle",
    class: "bg-[#6B7280] text-white",
  },
  AWS_LOAD_BALANCER_CONTROLLER: {
    name: "AWS Load Balancer Controller",
    class: "bg-[#8C4FFF] text-white",
  },
}

const PROJECTS = (projectsData as Project[]).map((project) => ({
  ...project,
  tags: project.tags.map((key) => TAGS[key]).filter(Boolean),
}))
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, imageAlt, title, description, tags, link, github, linkedin, gallery, repositories }) => (
    <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class:list={["relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-hidden rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(251,191,36,0.2)] lg:border lg:border-gray-800 lg:hover:border-yellow-400/30 lg:hover:bg-gray-800/50", gallery && "aspect-video bg-[#161616]"]}>
      <img alt={imageAlt ?? title} class:list={["w-full h-auto object-contain object-center transition duration-200", gallery && "h-full", gallery && "opacity-100"]} loading="lazy" src={image} {...(gallery ? { "data-project-image": true, "data-first-src": gallery[0].src, "data-first-alt": gallery[0].alt, "data-second-src": gallery[1].src, "data-second-alt": gallery[1].alt } : {})} />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true"></div>
      {gallery && (
        <button
          class="absolute right-3 top-1/2 z-10 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full border border-gray-600 bg-gray-900/90 text-xl text-white shadow-lg transition hover:border-yellow-400/60 hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-yellow-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900"
          type="button"
          data-image-toggle
          aria-label="Show Argo CD application resource tree"
          title="Show Argo CD application resource tree"
        >
          <span aria-hidden="true" data-toggle-icon>›</span>
        </button>
      )}
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <ul class="flex flex-row flex-wrap mt-3 gap-2">
      {tags.map((tag) => (
        <li>
          <span
            class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
          >
            {tag.icon && <tag.icon class="size-4" />}
            {tag.name}
          </span>
        </li>
      ))}
    </ul>

    <p class="mt-3 text-gray-700 dark:text-gray-400 text-pretty whitespace-pre-line">{description}</p>
    <footer class="flex flex-wrap items-center mt-4 gap-3">
      {repositories?.map(({ label, url }) => (
        <SocialPill href={url} aria-label={`Open ${label} repository`}>
          <GitHub class="size-5" />
          {label}
        </SocialPill>
      ))}
      {github && (
        <SocialPill href={github}>
          <GitHub class="size-5" />
          GitHub
        </SocialPill>
      )}
      {linkedin && (
        <SocialPill href={linkedin}>
          <LinkedIn class="size-5" />
          LinkedIn
        </SocialPill>
      )}
      {link && (
        <LinkButton href={link}>
          <ExternalLink class="size-4" />
          Preview
        </LinkButton>
      )}
    </footer>
  </div>
</article>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-image-toggle]").forEach((button) => {
    const container = button.parentElement
    const image = container?.querySelector<HTMLImageElement>("[data-project-image]")
    const icon = button.querySelector<HTMLElement>("[data-toggle-icon]")

    if (!image || !icon) return

    let showingSecondImage = false
    button.addEventListener("click", () => {
      showingSecondImage = !showingSecondImage
      image.classList.add("opacity-0")

      window.setTimeout(() => {
        image.src = showingSecondImage ? image.dataset.secondSrc! : image.dataset.firstSrc!
        image.alt = showingSecondImage ? image.dataset.secondAlt! : image.dataset.firstAlt!
        icon.textContent = showingSecondImage ? "‹" : "›"

        const label = showingSecondImage
          ? "Show VProfile GitOps architecture workflow"
          : "Show Argo CD application resource tree"
        button.setAttribute("aria-label", label)
        button.title = label
        image.classList.remove("opacity-0")
      }, 150)
    })
  })
</script>



